{
  "name": "vulcaescala",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:firebase": "firebase emulators:exec --config firebase/firebase.json --project demo-vulcaescala --only firestore,auth \"vitest run --config vitest.firebase.config.ts\"",
    "build:pages": "tsc --noEmit && vite build --mode pages && node scripts/stamp-sw.mjs ../escala"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "firebase": "^10.12.5",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "2.1.9"
  }
}
