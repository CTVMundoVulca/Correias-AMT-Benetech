rules_version = '2';

// VulcaEscala — contrato AMT. Projeto Firebase SEPARADO do contrato Suzano.
// Cole este conteúdo em: Console Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function emailOk() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }

    // Administradores: gerenciam quem tem acesso. Manter igual a ADMIN_EMAILS em src/cloud/config.ts
    function isAdmin() {
      return emailOk() && email() in [
        'glauber.dutra@benetechbrasil.com.br',
        'michael.lopes@benetechbrasil.com.br'
      ];
    }

    // Membros (liderança): e-mails liberados pelos administradores no próprio app.
    function isMember() {
      return isAdmin() || (
        emailOk()
        && exists(/databases/$(database)/documents/escala_config/membros)
        && email() in get(/databases/$(database)/documents/escala_config/membros).data.emails
      );
    }

    match /escala_config/membros {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['emails', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 100;
    }

    match /escala_efetivo/{workerId} {
      allow read: if isMember();
      allow delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.id == workerId
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80
        && request.resource.data.ativo is bool
        && request.resource.data.funcao in ['Vulcanizador', 'Líder', 'Encarregado', 'Mecânico', 'Soldador', 'Auxiliar'];
    }

    // Um documento por dia: "AAAA-Www_D" (D = 0 segunda … 6 domingo)
    match /escala_dias/{diaId} {
      allow read: if isMember();
      allow delete: if isMember();
      allow create, update: if isMember()
        && diaId.matches('^[0-9]{4}-W[0-9]{2}_[0-6]$')
        && request.resource.data.activities is list
        && request.resource.data.absences is list
        && request.resource.data.activities.size() <= 100
        && request.resource.data.absences.size() <= 200;
    }

    // Qualquer outra coleção: bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
