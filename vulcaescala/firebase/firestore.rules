rules_version = '2';

// VulcaEscala — contrato AMT. Projeto Firebase SEPARADO do contrato Suzano.
// Cole este conteúdo em: Console Firebase → Firestore Database → Regras → Publicar.
//
// QUEM EDITA: só os e-mails da lista em isAdmin() abaixo (cadastro manual).
// PARA INCLUIR UM ADMINISTRADOR (nesta ordem):
//   1) Console Firebase → Authentication → Usuários → Adicionar usuário (e-mail + senha);
//   2) inclua o e-mail na lista abaixo e clique em Publicar.
// Criar a conta ANTES de incluir o e-mail impede que outra pessoa se cadastre com ele.
// O app descobre sozinho quem é administrador (não precisa mudar o código do app).
service cloud.firestore {
  match /databases/{database}/documents {

    // Qualquer sessão do app, inclusive a anônima automática do Registro de Emenda
    function signedIn() { return request.auth != null; }

    function emailOk() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() { return request.auth.token.email.lower(); }

    // ═══ ADMINISTRADORES ═══ (e-mails em minúsculas, entre aspas, separados por vírgula)
    function isAdmin() {
      return emailOk() && email() in [
        'plantao.amt@benetechbrasil.com.br',
        'glauber.dutra@benetechbrasil.com.br',
        'warley.silva@benetechbrasil.com.br'
      ];
    }

    // Liderança = administradores (lista acima). A antiga liberação de e-mails pelo app
    // ("Acesso da liderança") não vale mais.
    function isMember() {
      return isAdmin();
    }

    // O app lê este documento só para saber se o usuário é administrador.
    match /escala_config/admin {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Antiga lista de membros liberados pelo app: não é mais usada.
    match /escala_config/membros {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Lista de funções do cadastro (editável pela liderança no app)
    match /escala_config/funcoes {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.data.keys().hasOnly(['lista', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.lista is list
        && request.resource.data.lista.size() > 0
        && request.resource.data.lista.size() <= 50;
    }

    // Feriados municipais (Vitória), editáveis pela liderança no app
    match /escala_config/feriados {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.data.keys().hasOnly(['map', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.map is map
        && request.resource.data.map.size() <= 200;
    }

    // Tipos de ausência (editáveis pela liderança no app)
    match /escala_config/ausencias {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.data.keys().hasOnly(['lista', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.lista is list
        && request.resource.data.lista.size() > 0
        && request.resource.data.lista.size() <= 30;
    }

    match /escala_efetivo/{workerId} {
      // só a liderança (o Registro de Emenda tem lista própria: emenda_config/efetivo)
      allow read: if isMember();
      allow delete: if isMember();
      allow create, update: if isMember()
        && request.resource.data.id == workerId
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80
        && request.resource.data.ativo is bool
        && request.resource.data.funcao is string
        && request.resource.data.funcao.size() > 0
        && request.resource.data.funcao.size() <= 40
        && (!('matricula' in request.resource.data)
            || (request.resource.data.matricula is string && request.resource.data.matricula.size() <= 30));
    }

    // Um documento por dia: "AAAA-Www_D" (D = 0 segunda … 6 domingo)
    match /escala_dias/{diaId} {
      allow read: if isMember();
      allow delete: if isMember();
      allow create, update: if isMember()
        && diaId.matches('^[0-9]{4}-W[0-9]{2}_[0-6]$')
        && request.resource.data.activities is list
        && request.resource.data.absences is list
        && request.resource.data.activities.size() <= 100
        && request.resource.data.absences.size() <= 200;
    }

    // ═══ ATRASOS NAS ATIVIDADES — qualquer pessoa com o link registra ═══
    // Corrigir/excluir: quem registrou (mesma sessão/aparelho) ou administrador.
    // Separado da escala: registrar atraso não permite mexer em atividades/alocações.
    function atrasoValido(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'semana', 'diaId', 'atividadeId', 'atividadeNome', 'inicio', 'fim',
                               'motivo', 'descricao', 'criadoUid', 'criadoEm', 'atualizadoEm', 'por'])
        && d.id == id
        && d.diaId is string && d.diaId.matches('^[0-9]{4}-W[0-9]{2}_[0-6]$')
        && d.semana == d.diaId.split('_')[0]
        && d.atividadeId is string && d.atividadeId.size() > 0 && d.atividadeId.size() <= 60
        && d.atividadeNome is string && d.atividadeNome.size() <= 80
        && d.inicio is string && d.inicio.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.fim is string && (d.fim == '' || d.fim.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && d.motivo is string && d.motivo.size() > 0 && d.motivo.size() <= 40
        && d.descricao is string && d.descricao.size() <= 500
        && d.por is string && d.por.size() <= 120;
    }

    match /escala_atrasos/{atrasoId} {
      allow read: if signedIn();
      allow create: if signedIn() && atrasoValido(atrasoId)
        && request.resource.data.criadoUid == request.auth.uid;
      allow update: if signedIn() && atrasoValido(atrasoId)
        && request.resource.data.criadoUid == resource.data.criadoUid
        && (resource.data.criadoUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (signedIn() && resource.data.criadoUid == request.auth.uid);
    }

    // Motivos de atraso (Bloqueio, Recurso, Limpeza + os criados por quem registra)
    match /escala_config/motivos_atraso {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['lista'])
        && request.resource.data.lista is list
        && request.resource.data.lista.size() > 0
        && request.resource.data.lista.size() <= 50;
    }

    // ═══ CÓPIA PÚBLICA DA ESCALA — visualização por qualquer pessoa com o link ═══
    // Mantida pelos aparelhos da liderança. Sem matrícula e sem o motivo de ausências
    // sensíveis (atestado/exame/falta aparecem como "ausencia"). Só a liderança grava.
    match /escala_publica/{diaId} {
      allow read: if signedIn();
      allow delete: if isMember();
      allow create, update: if isMember()
        && diaId.matches('^[0-9]{4}-W[0-9]{2}_[0-6]$')
        && request.resource.data.keys().hasOnly(['activities', 'absences'])
        && request.resource.data.activities is list
        && request.resource.data.absences is list
        && request.resource.data.activities.size() <= 100
        && request.resource.data.absences.size() <= 200;
    }

    match /escala_publica_config/geral {
      allow read: if signedIn();
      allow write: if isMember()
        && request.resource.data.keys().hasOnly(['efetivo', 'funcoes', 'ausencias', 'feriados'])
        && request.resource.data.efetivo is list
        && request.resource.data.efetivo.size() <= 300;
    }

    // ═══ REGISTRO DE EMENDA — acesso de qualquer pessoa com o link (sessão anônima) ═══
    function emendaValida() {
      let d = request.resource.data;
      return d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.tag is string && d.tag.size() <= 60
        && d.numero is string && d.numero.size() <= 30;
    }

    match /emendas/{emendaId} {
      allow read: if signedIn();
      // criadoUid = sessão (aparelho) que criou; só pode ser a própria e nunca muda depois
      allow create: if signedIn() && emendaValida()
        && request.resource.data.get('criadoUid', request.auth.uid) == request.auth.uid;
      allow update: if signedIn() && emendaValida()
        && request.resource.data.get('criadoUid', '') == resource.data.get('criadoUid', '');
      // excluir: quem criou o relatório (mesmo aparelho) ou a liderança (membros e administradores)
      allow delete: if isMember()
        || (signedIn() && resource.data.get('criadoUid', '') != '' && resource.data.criadoUid == request.auth.uid);

      match /fotos/{fotoId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['id', 'ordem', 'legenda', 'data', 'criadoEm'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000
          && request.resource.data.legenda is string
          && request.resource.data.legenda.size() <= 60;
        allow delete: if signedIn();
      }
    }

    // Colaboradores do Registro de Emenda (nome + matrícula/CPF), separados do efetivo da escala.
    // Como no app do Suzano, qualquer pessoa usando o app pode manter a lista.
    match /emenda_config/efetivo {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['lista'])
        && request.resource.data.lista is list
        && request.resource.data.lista.size() <= 300;
    }

    match /emenda_config/listas {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['materiaisEmenda', 'materiaisManta', 'fabricantes', 'equipamentos'])
        && request.resource.data.materiaisEmenda.size() <= 100
        && request.resource.data.materiaisManta.size() <= 100
        && request.resource.data.fabricantes.size() <= 30
        && request.resource.data.get('equipamentos', []).size() <= 30;
    }

    // ═══ PROGRAMAÇÃO DA VULCANIZAÇÃO ═══
    // PAINEL (todos com o link, sessão anônima): vê programação, paradas confirmadas, fila de
    // solicitações e relatórios; pede serviço e informa paradas.
    // GESTÃO (login + papel, cadastrado pelo administrador em prog_config/papeis):
    //   programador  → programação, solicitações, confirmação de paradas, baixa das OMs
    //   supervisor   → só o retorno das OMs (realizada/pendente), em prog_retornos
    //   administrador → tudo + cadastro dos papéis (os administradores da escala também são)
    function papeisDoc() { return /databases/$(database)/documents/prog_config/papeis; }
    function temPapel(p) {
      return emailOk() && exists(papeisDoc()) && email() in get(papeisDoc()).data.get(p, []);
    }
    function isProgAdmin() { return isAdmin() || temPapel('admins'); }
    function isProgramador() { return isProgAdmin() || temPapel('programadores'); }
    function isSupervisor() { return isProgAdmin() || temPapel('supervisores'); }

    match /prog_config/papeis {
      allow read: if emailOk();
      allow write: if isProgAdmin()
        && request.resource.data.keys().hasOnly(['admins', 'programadores', 'supervisores'])
        && request.resource.data.admins is list && request.resource.data.admins.size() <= 50
        && request.resource.data.programadores is list && request.resource.data.programadores.size() <= 50
        && request.resource.data.supervisores is list && request.resource.data.supervisores.size() <= 100;
    }

    // Um documento por mês com as atividades: { itens: { atividadeId: {...} } }
    match /prog_mes/{mes} {
      allow read: if signedIn();
      allow create, update: if isProgramador()
        && mes.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['itens', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.itens is map
        && request.resource.data.itens.size() <= 1000;
    }

    // Cadastro e baixa das OMs (programação), um documento por ano. Só a Gestão vê.
    match /prog_oms/{ano} {
      allow read: if isProgramador() || isSupervisor();
      allow create, update: if isProgramador()
        && ano.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['oms', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.oms is map
        && request.resource.data.oms.size() <= 5000;
    }

    // Retorno das OMs marcado pelo supervisor (realizada/pendente), separado da baixa
    match /prog_retornos/{ano} {
      allow read: if isProgramador() || isSupervisor();
      allow create, update: if isSupervisor()
        && ano.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['retornos', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.retornos is map
        && request.resource.data.retornos.size() <= 5000;
    }

    // Calendário de paradas CONFIRMADAS (todos veem; a programação lança/confirma)
    match /prog_paradas/{ano} {
      allow read: if signedIn();
      allow create, update: if isProgramador()
        && ano.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['paradas', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.paradas is map
        && request.resource.data.paradas.size() <= 2000;
    }

    // Paradas informadas pelas áreas (a confirmar pela programação)
    function pedidoParadaValido(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'tipo', 'area', 'equipamento', 'descricao', 'inicio', 'fim', 'solicitante', 'contato',
                               'criadoUid', 'criadoEm', 'criadoPor', 'status', 'resposta', 'atualizadoEm', 'atualizadoPor'])
        && d.id == id
        && d.tipo in ['geral', 'parcial', 'critica']
        && d.area is string && d.area.size() > 0 && d.area.size() <= 60
        && d.equipamento is string && d.equipamento.size() <= 60
        && d.descricao is string && d.descricao.size() <= 200
        && d.inicio is string && d.inicio.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.fim is string && d.fim.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.fim >= d.inicio
        && d.solicitante is string && d.solicitante.size() > 0 && d.solicitante.size() <= 80
        && d.contato is string && d.contato.size() <= 80
        && d.criadoEm is string
        && d.status in ['pendente', 'confirmada', 'recusada', 'cancelada']
        && d.resposta is string && d.resposta.size() <= 300;
    }
    match /prog_paradas_pedidos/{pedidoId} {
      allow read: if signedIn();
      allow create: if signedIn() && pedidoParadaValido(pedidoId)
        && request.resource.data.criadoUid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.resposta == '';
      allow update: if signedIn() && pedidoParadaValido(pedidoId)
        && request.resource.data.criadoUid == resource.data.criadoUid
        && request.resource.data.criadoEm == resource.data.criadoEm
        && (isProgramador()
            || (resource.data.criadoUid == request.auth.uid
                && resource.data.status == 'pendente'
                && request.resource.data.status in ['pendente', 'cancelada']
                && request.resource.data.resposta == resource.data.resposta));
      allow delete: if isProgramador();
    }

    // Áreas solicitantes e o contato de cada uma
    match /prog_config/areas {
      allow read: if signedIn();
      allow write: if isProgramador()
        && request.resource.data.keys().hasOnly(['lista'])
        && request.resource.data.lista is list
        && request.resource.data.lista.size() <= 80;
    }

    // Solicitações das áreas: qualquer pessoa com o link pede; quem pediu (mesmo aparelho)
    // pode corrigir ou cancelar enquanto estiver aberta; só administradores programam/recusam.
    function solicitacaoValida(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'area', 'equipamento', 'om', 'descricao', 'urgencia', 'dataDesejada',
                               'solicitante', 'contato', 'criadoUid', 'criadoEm', 'status', 'resposta',
                               'atividadeId', 'dataProgramada', 'atualizadoEm', 'atualizadoPor'])
        && d.id == id
        && d.area is string && d.area.size() > 0 && d.area.size() <= 60
        && d.equipamento is string && d.equipamento.size() <= 60
        && d.om is string && (d.om == '' || d.om.matches('^[0-9]{6,14}$'))
        && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 500
        && d.urgencia in ['normal', 'urgente', 'emergencia']
        && d.dataDesejada is string && d.dataDesejada.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.solicitante is string && d.solicitante.size() > 0 && d.solicitante.size() <= 80
        && d.contato is string && d.contato.size() <= 80
        && d.criadoEm is string
        && d.status in ['aberta', 'programada', 'recusada', 'cancelada']
        && d.resposta is string && d.resposta.size() <= 300
        && d.atividadeId is string && d.atividadeId.size() <= 60
        && d.dataProgramada is string && d.dataProgramada.size() <= 10
        && d.atualizadoPor is string && d.atualizadoPor.size() <= 120;
    }

    match /prog_solicitacoes/{solicId} {
      allow read: if signedIn();
      allow create: if signedIn() && solicitacaoValida(solicId)
        && request.resource.data.criadoUid == request.auth.uid
        && request.resource.data.status == 'aberta'
        && request.resource.data.resposta == ''
        && request.resource.data.atividadeId == '';
      allow update: if signedIn() && solicitacaoValida(solicId)
        && request.resource.data.criadoUid == resource.data.criadoUid
        && request.resource.data.criadoEm == resource.data.criadoEm
        && (isProgramador()
            || (resource.data.criadoUid == request.auth.uid
                && resource.data.status == 'aberta'
                && request.resource.data.status in ['aberta', 'cancelada']
                && request.resource.data.resposta == resource.data.resposta
                && request.resource.data.atividadeId == resource.data.atividadeId
                && request.resource.data.dataProgramada == resource.data.dataProgramada));
      allow delete: if isProgramador();
    }

    // Qualquer outra coleção: bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
